package templates

import (
	"strconv"
	"github.com/dr-duke/talmorGo/internal/model"
)

func itoa(n int) string { return strconv.Itoa(n) }

// SidebarNav — фрагмент боковой навигации (обновляется после изменения коллекций).
templ SidebarNav(cols []*model.Collection) {
	<nav class="sidebar" id="sidebar">
		<button class="sidebar-nav-item sidebar-queue-item" id="sidebar-queue-btn" data-action="nav-queue">
			<span class="mi">pending</span>Очередь
		</button>
		<div class="sidebar-queue-divider"></div>
		<button class="sidebar-nav-item active" data-kind="" data-action="nav-kind">
			<span class="mi">list</span>Все
		</button>
		<button class="sidebar-nav-item" data-kind="video" data-action="nav-kind">
			<span class="mi">videocam</span>Видео
		</button>
		<button class="sidebar-nav-item" data-kind="audio" data-action="nav-kind">
			<span class="mi">audio_file</span>Аудио
		</button>
		if len(cols) > 0 {
			<div class="sidebar-divider"></div>
			<span class="sidebar-section-label">Коллекции</span>
			for _, c := range cols {
				<div class="sidebar-coll-row row-menu-wrap">
					<button
						class="sidebar-nav-item"
						data-coll={ c.Name }
						data-action="nav-coll"
						title={ c.Name }
					>
						<span class="mi">folder</span>
						<span class="sidebar-coll-name">{ c.Name }</span>
						if c.ItemCount > 0 {
							<span class="sidebar-count">{ itoa(c.ItemCount) }</span>
						}
					</button>
					<button class="icon-btn sidebar-coll-menu" title="Действия" data-action="row-menu">
						<span class="mi">more_vert</span>
					</button>
					<div class="row-menu">
						<button
							class="row-menu-item"
							data-coll-id={ c.ID }
							data-coll-name={ c.Name }
							data-action="coll-rename"
						><span class="mi">edit</span>Переименовать</button>
						<button
							class="row-menu-item danger"
							data-coll-id={ c.ID }
							data-coll-name={ c.Name }
							data-action="coll-delete"
						><span class="mi">delete</span>Удалить коллекцию</button>
					</div>
				</div>
			}
		}
	</nav>
}

templ Index(basePath string, siteName string, cols []*model.Collection) {
	@Layout("Медиатека", basePath, siteName) {
		<div class="app-shell">
			<!-- ── Шапка ── -->
			<header class="app-header">
				<a class="header-logo" href="./">
					<img src="static/logo.svg" width="28" height="28" alt=""/>
					<span class="header-logo-name">{ siteName }</span>
				</a>
				<div class="header-spacer"></div>
				<form
					class="header-add-form"
					hx-post="queue"
					hx-swap="none"
					hx-on::after-request="if(event.detail.successful)this.reset()"
				>
					<input
						type="url"
						name="url"
						class="header-url-input"
						placeholder="Вставьте ссылку…"
						autocomplete="off"
						required
					/>
					<button type="submit" class="btn btn-primary btn-sm">
						<span class="mi">download</span>
						<span class="header-add-btn-text">Скачать</span>
					</button>
				</form>
				<a href="settings" class="icon-btn" title="Настройки"><span class="mi">settings</span></a>
			</header>

			<div class="app-body">
				@SidebarNav(cols)

				<main class="main-content">
					<!-- ── Медиатека ── -->
					<div id="lib-section" class="content-inner">
						<div class="toolbar">
							<input
								type="search"
								id="media-search"
								class="search-input"
								placeholder="Поиск по названию, URL, домену…"
								data-action-input="search"
							/>
							<div class="toolbar-chips">
								<div
									id="tag-cloud"
									hx-get="library/tags"
									hx-trigger="load once, tagsRefresh from:body"
									hx-swap="outerHTML"
								></div>
							</div>
							<button
								class="icon-btn"
								data-action="select-all"
								title="Выбрать все отображаемые"
							>
								<span class="mi">checklist</span>
							</button>
						</div>

						<div id="play-all-bar" class="play-all-bar">
							<span class="mi play-all-icon">folder</span>
							<span class="play-all-title" id="play-all-title"></span>
							<button class="btn btn-primary btn-sm" data-action="play-all">
								<span class="mi">play_arrow</span>Воспроизвести всё
							</button>
						</div>

						<div
							id="media-inner"
							hx-get="library/items"
							hx-trigger="load, mediaRefresh from:body"
							hx-swap="outerHTML"
							hx-include="#filter-form"
						>
							<div class="empty-state" id="media-loading">
								<span class="mi">hourglass_empty</span>
								<p>Загрузка…</p>
							</div>
						</div>

						<!-- Скрытая форма фильтров: HTMX подмешивает её в запросы фрагментов -->
						<form id="filter-form" class="hidden-form">
							<input id="filter-q" name="q" type="hidden"/>
							<input id="filter-kind" name="kind" type="hidden"/>
							<input id="filter-tag" name="tag" type="hidden"/>
						</form>
					</div>

					<!-- ── Очередь ── -->
					<div id="queue-section" class="content-inner" style="display:none">
						<div class="queue-toolbar">
							<button
								class="btn btn-ghost btn-sm"
								hx-post="queue/cancel-all"
								hx-swap="none"
								title="Отменить все активные задачи"
							>
								<span class="mi">cancel</span>Отменить все активные
							</button>
						</div>
						<div
							id="queue-inner"
							hx-get="queue/items"
							hx-trigger="load, queueRefresh from:body"
							hx-swap="outerHTML"
						>
							<div class="empty-state">
								<span class="mi">hourglass_empty</span>
								<p>Загрузка…</p>
							</div>
						</div>
					</div>
				</main>
			</div>
		</div>

		<!-- ── Диалог видеоплеера ── -->
		<dialog id="player-dialog">
			<div class="dialog-header video-dialog-header">
				<span class="dialog-title" id="player-title"></span>
				<button class="icon-btn" data-action="player-minimize" title="Свернуть">
					<span class="mi">close_fullscreen</span>
				</button>
				<button class="icon-btn player-close" data-action="player-close" title="Закрыть">
					<span class="mi">close</span>
				</button>
			</div>
			<div id="player-wrap">
				<video id="main-player" playsinline></video>
			</div>
		</dialog>

		<!-- Аудио проигрывается скрытым элементом, управление — в нижней панели -->
		<audio id="audio-player" preload="auto"></audio>

		<!-- ── Панель плеера ── -->
		<div id="player-bar" class="player-bar">
			<div class="pb-info">
				<span class="mi pb-kind-icon" id="pb-kind-icon">play_circle</span>
				<span class="pb-title" id="pb-title"></span>
			</div>
			<div class="pb-center">
				<span class="pb-time" id="pb-current">0:00</span>
				<div class="pb-track" id="pb-track" data-action="player-seek">
					<div class="pb-fill" id="pb-fill"></div>
				</div>
				<span class="pb-time" id="pb-duration">0:00</span>
			</div>
			<div class="pb-controls">
				<button class="icon-btn" id="pb-expand-btn" data-action="player-expand" title="Развернуть" style="display:none">
					<span class="mi">open_in_full</span>
				</button>
				<button class="icon-btn pb-play-btn" id="pb-play-btn" data-action="player-toggle" title="Пауза/Воспроизведение">
					<span class="mi" id="pb-play-icon">pause</span>
				</button>
				<button class="icon-btn" data-action="player-close" title="Остановить">
					<span class="mi">close</span>
				</button>
			</div>
		</div>

		<dialog id="log-dialog">
			<div class="dialog-header">
				<span class="dialog-title" id="log-title">Лог скачивания</span>
				<button class="icon-btn player-close" data-action="dialog-close" data-dialog="log-dialog">
					<span class="mi">close</span>
				</button>
			</div>
			<pre id="log-content">Загрузка…</pre>
		</dialog>

		<!-- ── Диалог редактирования аудио-тегов ── -->
		<dialog id="meta-dialog">
			<div class="dialog-header">
				<span class="dialog-title" id="meta-dialog-title">Теги аудио</span>
				<button class="icon-btn" data-action="dialog-close" data-dialog="meta-dialog">
					<span class="mi">close</span>
				</button>
			</div>
			<div class="meta-dialog-body">
				<table class="meta-matrix">
					<tbody>
						@metaField("title", "Название", "Название трека")
						@metaField("artist", "Исполнитель", "Исполнитель")
						@metaField("album", "Альбом", "Альбом")
						@metaField("year", "Год", "2024")
						@metaField("genre", "Жанр", "Жанр")
					</tbody>
				</table>
				<div class="meta-footer">
					<span id="meta-count-note" class="meta-count-note"></span>
					<button class="btn btn-primary btn-sm" data-action="meta-apply">Применить</button>
				</div>
			</div>
		</dialog>

		@ActionBar()

		<script type="module" src="static/js/main.js"></script>
	}
}

// metaField — строка диалога тегов: галочка «применять», подпись и поле ввода.
templ metaField(field, label, placeholder string) {
	<tr class="meta-row" data-field={ field }>
		<td><input type="checkbox" class="meta-check" data-action-change="meta-check"/></td>
		<td class="meta-label">{ label }</td>
		<td>
			<input
				type="text"
				class="meta-input"
				id={ "meta-" + field }
				placeholder={ placeholder }
			/>
		</td>
	</tr>
}
